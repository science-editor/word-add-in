{
  "name": "office-addin-taskpane-react",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane-React.git"
  },
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 7070
  },
  "scripts": {
    "prebuild": "cp manifest.prod.xml manifest.xml",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "validate": "office-addin-manifest validate manifest.xml",
    "dev-server": "webpack serve --mode development --port 7070",
    "start:word": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "patch-manifest": "node scripts/patch-manifest.js",
    "killports": "kill-port 7070 3001",
    "dev": "npm-run-all -s stop patch-manifest killports -p dev-server start:word",
    "start": "npm-run-all -s patch-manifest start:word"
  },
  "dependencies": {
    "@apollo/client": "^3.12.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fluentui/react-components": "^9.46.8",
    "@fluentui/react-icons": "^2.0.232",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "core-js": "^3.36.0",
    "es6-promise": "^4.2.8",
    "express": "^5.1.0",
    "graphql": "^16.10.0",
    "http-proxy-middleware": "^3.0.5",
    "nanoid": "^5.0.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^11.0.5",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.501",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "acorn": "^8.11.3",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "eslint-plugin-office-addins": "^3.0.2",
    "eslint-plugin-react": "^7.28.0",
    "file-loader": "^6.2.0",
    "html-loader": "^1.3.2",
    "html-webpack-plugin": "^4.5.2",
    "kill-port": "^2.0.1",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "npm-run-all": "^4.1.5",
    "office-addin-cli": "^1.6.5",
    "office-addin-debugging": "^5.1.6",
    "office-addin-lint": "^2.3.5",
    "office-addin-manifest": "^1.13.6",
    "office-addin-prettier-config": "^1.2.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.1.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "not ie <= 11"
  ]
}
